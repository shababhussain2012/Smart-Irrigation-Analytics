# Excel temp/lock files
~$*.xlsx
~$*.xls

# Power BI temp/cache files
*.pbix.bak
*.pbit.bak
.pbi/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE files
.vscode/
*.swp

# Scratch/debug files used during development, not part of the deliverable
_expected_*.csv
verify_*.py
*_scratch.*
*_test.py

# Keep these even though they're data files -- do NOT ignore
!data/raw/*.csv
!data/cleaned/*.csv
